# barre fuzz case (docs/FUZZ.md)
# class both (over scales 0 and 1)
# minimised from seed 2168 mode 2, knobs default: 25 -> 6 nodes, 7 -> 4 sizes, 177 checks
# at scale 0, last size: /0/0/1/0 height: relayout 1 fresh 20 (and 1 more)
mode 2              # root style width, undefined available size; height unused
scale 0
errata all
sizes 300x800 100x640 200x500 100x800
root
  node dir=row ai=flex-start                                # /0
    node dir=row                                            # /0/0
      node text=250                                         # /0/0/0
      node basis=1 h=1%                                     # /0/0/1
        node basis=1 text=1                                 # /0/0/1/0
