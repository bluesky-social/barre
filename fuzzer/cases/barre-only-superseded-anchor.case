# barre fuzz case (docs/FUZZ.md)
# class both (over scales 0 and 1)
# minimised from seed 8266 mode 2, knobs default: 17 -> 5 nodes, 7 -> 3 sizes, 124 checks
# at scale 1, last size: /0/0/0/0 height: relayout 1 fresh 20
mode 2              # root style width, undefined available size; height unused
scale 1
errata all
sizes 400x800 100x400 400x800
root
  node dir=row ovf=scroll                                   # /0
    node dir=row grow=1                                     # /0/0
      node                                                  # /0/0/0
        node basis=1 text=1                                 # /0/0/0/0
