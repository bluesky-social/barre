diff --git a/ReactCommon/yoga/yoga/barre/BarreHost.cpp b/ReactCommon/yoga/yoga/barre/BarreHost.cpp
new file mode 100644
index 0000000..015539f
--- /dev/null
+++ b/ReactCommon/yoga/yoga/barre/BarreHost.cpp
@@ -0,0 +1,352 @@
+/*
+ * barre for React Native: see BarreHost.h and BarreRn.h.
+ */
+
+#include <yoga/barre/BarreHost.h>
+
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+#include <utility>
+#include <vector>
+
+#include <yoga/YGEnums.h>
+#include <yoga/config/Config.h>
+#include <yoga/enums/Edge.h>
+#include <yoga/enums/ExperimentalFeature.h>
+#include <yoga/enums/Gutter.h>
+#include <yoga/enums/MeasureMode.h>
+#include <yoga/style/Style.h>
+
+#ifdef __ANDROID__
+#include <android/log.h>
+#include <sys/system_properties.h>
+#endif
+
+namespace facebook::yoga {
+
+namespace {
+
+// barre reads std::vector<Node*> as {begin, end, capacity end} (libc++).
+static_assert(sizeof(std::vector<Node*>) == 3 * sizeof(Node*));
+static_assert(sizeof(FloatOptional) == sizeof(float));
+
+void barreLog(const char* message) {
+#ifdef __ANDROID__
+  __android_log_print(ANDROID_LOG_WARN, "barre", "%s", message);
+#else
+  fprintf(stderr, "barre: %s\n", message);
+#endif
+}
+
+template <typename T>
+uint32_t offsetIn(const void* base, const T* field) {
+  return static_cast<uint32_t>(
+      reinterpret_cast<const std::byte*>(field) -
+      reinterpret_cast<const std::byte*>(base));
+}
+
+BarreRnLength length(const YGValue& value) {
+  return BarreRnLength{value.value, static_cast<uint8_t>(value.unit)};
+}
+
+template <typename Get>
+uint16_t edges(BarreRnLength (&out)[9], Get get) {
+  uint16_t defined = 0;
+  for (size_t i = 0; i < 9; i++) {
+    out[i] = length(get(static_cast<Edge>(i)));
+    if (out[i].unit != YGUnitUndefined) {
+      defined |= static_cast<uint16_t>(1u << i);
+    }
+  }
+  return defined;
+}
+
+void flattenStyle(const void* nodeRef, BarreRnStyle* out) {
+  const Style& s = static_cast<const Node*>(nodeRef)->style();
+  out->direction = static_cast<uint8_t>(s.direction());
+  out->flex_direction = static_cast<uint8_t>(s.flexDirection());
+  out->justify_content = static_cast<uint8_t>(s.justifyContent());
+  out->justify_items = static_cast<uint8_t>(s.justifyItems());
+  out->justify_self = static_cast<uint8_t>(s.justifySelf());
+  out->align_content = static_cast<uint8_t>(s.alignContent());
+  out->align_items = static_cast<uint8_t>(s.alignItems());
+  out->align_self = static_cast<uint8_t>(s.alignSelf());
+  out->position_type = static_cast<uint8_t>(s.positionType());
+  out->flex_wrap = static_cast<uint8_t>(s.flexWrap());
+  out->overflow = static_cast<uint8_t>(s.overflow());
+  out->display = static_cast<uint8_t>(s.display());
+  out->box_sizing = static_cast<uint8_t>(s.boxSizing());
+  out->flex = s.flex().unwrap();
+  out->flex_grow = s.flexGrow().unwrap();
+  out->flex_shrink = s.flexShrink().unwrap();
+  out->aspect_ratio = s.aspectRatio().unwrap();
+  out->flex_basis = length(static_cast<YGValue>(s.flexBasis()));
+  out->defined_margin = edges(out->margin, [&](Edge e) {
+    return static_cast<YGValue>(s.margin(e));
+  });
+  out->defined_position = edges(out->position, [&](Edge e) {
+    return static_cast<YGValue>(s.position(e));
+  });
+  out->defined_padding = edges(out->padding, [&](Edge e) {
+    return static_cast<YGValue>(s.padding(e));
+  });
+  out->defined_border = edges(out->border, [&](Edge e) {
+    return static_cast<YGValue>(s.border(e));
+  });
+  for (size_t i = 0; i < 3; i++) {
+    out->gap[i] = length(static_cast<YGValue>(s.gap(static_cast<Gutter>(i))));
+  }
+  for (size_t i = 0; i < 2; i++) {
+    auto d = static_cast<Dimension>(i);
+    out->dimensions[i] = length(static_cast<YGValue>(s.dimension(d)));
+    out->min_dimensions[i] = length(static_cast<YGValue>(s.minDimension(d)));
+    out->max_dimensions[i] = length(static_cast<YGValue>(s.maxDimension(d)));
+  }
+}
+
+void readConfig(const void* configRef, BarreRnConfig* out) {
+  const auto* config = static_cast<const Config*>(configRef);
+  out->errata = static_cast<uint32_t>(config->getErrata());
+  uint32_t features = 0;
+  for (size_t i = 0; i < ordinalCount<ExperimentalFeature>(); i++) {
+    if (config->isExperimentalFeatureEnabled(
+            static_cast<ExperimentalFeature>(i))) {
+      features |= 1u << i;
+    }
+  }
+  out->experimental_features = features;
+  out->point_scale_factor = config->getPointScaleFactor();
+  out->use_web_defaults = config->useWebDefaults();
+}
+
+void markDirty(void* node) {
+  static_cast<Node*>(node)->setDirty(true);
+}
+
+void cloneChildrenIfNeeded(void* node) {
+  static_cast<Node*>(node)->cloneChildrenIfNeeded();
+}
+
+void cloneContentsChildrenIfNeeded(void* node) {
+  static_cast<Node*>(node)->cloneContentsChildrenIfNeeded();
+}
+
+BarreRnSize measure(
+    void* node,
+    float width,
+    uint8_t widthMode,
+    float height,
+    uint8_t heightMode) {
+  YGSize size = static_cast<Node*>(node)->measure(
+      width,
+      static_cast<MeasureMode>(widthMode),
+      height,
+      static_cast<MeasureMode>(heightMode));
+  return BarreRnSize{size.width, size.height};
+}
+
+BarreRnSize measureMinContent(
+    void* node,
+    float width,
+    uint8_t widthMode,
+    float height,
+    uint8_t heightMode) {
+  YGSize size = static_cast<Node*>(node)->measureMinContent(
+      width,
+      static_cast<MeasureMode>(widthMode),
+      height,
+      static_cast<MeasureMode>(heightMode));
+  return BarreRnSize{size.width, size.height};
+}
+
+float baseline(void* node, float width, float height) {
+  return static_cast<const Node*>(node)->baseline(width, height);
+}
+
+// Finds the one bit a flag setter changes, by constructing two nodes in
+// zeroed memory and toggling the flag on one of them. `setOn` sets the flag
+// to the value the bit represents when set (true, or NodeType::Text).
+template <typename Toggle>
+bool probeFlag(
+    uint32_t flagsEnd,
+    bool toggledTurnsOn,
+    Toggle toggle,
+    BarreRnFlag* out) {
+  alignas(Node) std::byte a[sizeof(Node)];
+  alignas(Node) std::byte b[sizeof(Node)];
+  std::memset(a, 0, sizeof(a));
+  std::memset(b, 0, sizeof(b));
+  Node* na = new (a) Node();
+  Node* nb = new (b) Node();
+  toggle(*nb);
+  int found = 0;
+  for (uint32_t i = 0; i < flagsEnd; i++) {
+    auto diff = static_cast<uint8_t>(a[i] ^ b[i]);
+    if (diff != 0) {
+      found++;
+      out->offset = i;
+      out->mask = diff;
+    }
+  }
+  bool ok = found == 1 && (out->mask & (out->mask - 1)) == 0;
+  if (ok) {
+    // the bit must be set in whichever node has the flag on
+    const std::byte* on = toggledTurnsOn ? b : a;
+    ok = (static_cast<uint8_t>(on[out->offset]) & out->mask) != 0;
+  }
+  na->~Node();
+  nb->~Node();
+  return ok;
+}
+
+} // namespace
+
+const BarreRnHost* BarreHostAccess::host() {
+  static const BarreRnHost* const host = []() -> const BarreRnHost* {
+    static BarreRnHost h{};
+    h.abi_version = BARRE_RN_ABI_VERSION;
+    h.struct_size = sizeof(BarreRnHost);
+    h.state_capacity = BARRE_RN_STATE_SIZE;
+
+    Node probe;
+    h.node_state = offsetIn(&probe, &probe.barreState_);
+    h.node_children = offsetIn(&probe, &probe.children_);
+    h.node_owner = offsetIn(&probe, &probe.owner_);
+    h.node_config = offsetIn(&probe, &probe.config_);
+    h.node_contents_children_count =
+        offsetIn(&probe, &probe.contentsChildrenCount_);
+    h.node_measure_func = offsetIn(&probe, &probe.measureFunc_);
+    h.node_min_content_measure_func =
+        offsetIn(&probe, &probe.minContentMeasureFunc_);
+    h.node_baseline_func = offsetIn(&probe, &probe.baselineFunc_);
+    h.node_min_content_width = offsetIn(&probe, &probe.minContentWidth_);
+    h.node_min_content_height = offsetIn(&probe, &probe.minContentHeight_);
+
+    // children_ must be {begin, end, ...}
+    Node c0, c1;
+    probe.setChildren({&c0, &c1});
+    auto words = reinterpret_cast<Node* const* const*>(
+        reinterpret_cast<const std::byte*>(&probe) + h.node_children);
+    const bool vectorOk = words[0] == probe.getChildren().data() &&
+        words[1] == probe.getChildren().data() + 2;
+    probe.setChildren({});
+
+    // the flags are bitfields before context_
+    const uint32_t flagsEnd = offsetIn(&probe, &probe.context_);
+    const bool flagsOk =
+        probeFlag(
+            flagsEnd,
+            false,
+            [](Node& n) { n.setDirty(false); },
+            &h.flag_dirty) &&
+        probeFlag(
+            flagsEnd,
+            false,
+            [](Node& n) { n.setHasNewLayout(false); },
+            &h.flag_has_new_layout) &&
+        probeFlag(
+            flagsEnd,
+            true,
+            [](Node& n) { n.setIsReferenceBaseline(true); },
+            &h.flag_reference_baseline) &&
+        probeFlag(
+            flagsEnd,
+            true,
+            [](Node& n) { n.setAlwaysFormsContainingBlock(true); },
+            &h.flag_always_forms_containing_block) &&
+        probeFlag(
+            flagsEnd,
+            true,
+            [](Node& n) { n.setNodeType(NodeType::Text); },
+            &h.flag_node_type_text);
+
+    Config config{nullptr};
+    h.config_version = offsetIn(&config, &config.version_);
+
+    h.flatten_style = flattenStyle;
+    h.read_config = readConfig;
+    h.mark_dirty = markDirty;
+    h.clone_children_if_needed = cloneChildrenIfNeeded;
+    h.clone_contents_children_if_needed = cloneContentsChildrenIfNeeded;
+    h.measure = measure;
+    h.measure_min_content = measureMinContent;
+    h.baseline = baseline;
+
+    if (!vectorOk) {
+      barreLog("unexpected std::vector layout");
+      return nullptr;
+    }
+    if (!flagsOk) {
+      barreLog("could not locate yoga::Node's flag bits");
+      return nullptr;
+    }
+    if (h.node_state % BARRE_RN_STATE_ALIGN != 0) {
+      barreLog("barre state is misaligned");
+      return nullptr;
+    }
+    return &h;
+  }();
+  return host;
+}
+
+namespace barre {
+namespace detail {
+
+BarreRnLayoutOffsets gLayoutOffsets{};
+
+#ifdef BARRE_RN
+namespace {
+bool requested() {
+#ifdef __ANDROID__
+  char value[PROP_VALUE_MAX] = {};
+  __system_property_get("debug.barre.layout", value);
+  return value[0] == '1';
+#else
+  const char* value = std::getenv("BARRE_LAYOUT");
+  return value != nullptr && value[0] == '1';
+#endif
+}
+} // namespace
+
+bool computeEnabled() {
+  if (!requested()) {
+    return false;
+  }
+  const BarreRnHost* host = BarreHostAccess::host();
+  if (host == nullptr || !barre_rn_init(host)) {
+    // Never fall back silently: an A/B run would compare Yoga with itself.
+    barreLog("barre requested but its host interface does not match this build");
+    std::abort();
+  }
+  gLayoutOffsets = barre_rn_layout_offsets();
+  barreLog("laying out with barre");
+  return true;
+}
+#else
+bool computeEnabled() {
+  return false;
+}
+#endif
+
+} // namespace detail
+
+void calculateLayout(
+    Node* node,
+    float ownerWidth,
+    float ownerHeight,
+    Direction ownerDirection) {
+#ifdef BARRE_RN
+  barre_rn_calculate_layout(
+      node, ownerWidth, ownerHeight, static_cast<uint8_t>(ownerDirection));
+#else
+  (void)node;
+  (void)ownerWidth;
+  (void)ownerHeight;
+  (void)ownerDirection;
+#endif
+}
+
+} // namespace barre
+} // namespace facebook::yoga
diff --git a/ReactCommon/yoga/yoga/barre/BarreHost.h b/ReactCommon/yoga/yoga/barre/BarreHost.h
new file mode 100644
index 0000000..507d921
--- /dev/null
+++ b/ReactCommon/yoga/yoga/barre/BarreHost.h
@@ -0,0 +1,121 @@
+/*
+ * barre for React Native (yoga/barre/BarreRn.h): the C++ side. Owns the
+ * runtime switch between Yoga's algorithm and barre's, the host vtable barre
+ * walks yoga::Nodes through, and direct reads of barre's layout results for
+ * the YGNodeLayoutGet* API.
+ *
+ * Built into every Yoga build; barre itself is only linked when BARRE_RN is
+ * defined (the barre-rn staticlib is available). Without it, enabled() is
+ * always false and Yoga runs unchanged.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <yoga/barre/BarreRn.h>
+#include <yoga/enums/Dimension.h>
+#include <yoga/enums/Direction.h>
+#include <yoga/enums/PhysicalEdge.h>
+#include <yoga/node/Node.h>
+
+namespace facebook::yoga {
+
+struct BarreHostAccess {
+  static const std::byte* state(const Node& node) {
+    return node.barreState_;
+  }
+  static const BarreRnHost* host();
+};
+
+namespace barre {
+
+namespace detail {
+bool computeEnabled();
+extern BarreRnLayoutOffsets gLayoutOffsets;
+} // namespace detail
+
+/*
+ * Whether this process lays out with barre. Decided once, on first use:
+ * iOS/macOS reads the BARRE_LAYOUT environment variable (simulator:
+ * SIMCTL_CHILD_BARRE_LAYOUT=1), Android the debug.barre.layout system
+ * property. Never changes afterwards: Yoga's and barre's caches would go
+ * stale relative to each other.
+ */
+inline bool enabled() {
+#ifdef BARRE_RN
+  static const bool on = detail::computeEnabled();
+  return on;
+#else
+  return false;
+#endif
+}
+
+/*
+ * barre's layout results for `node`, or null when the node's results live in
+ * Yoga's LayoutResults: barre is off, or barre has not laid the node out
+ * since it was created or reset (Yoga's defaults are in layout_ then).
+ */
+class LayoutView {
+ public:
+  explicit LayoutView(const std::byte* state) : state_(state) {}
+
+  Direction direction() const {
+    return static_cast<Direction>(
+        *reinterpret_cast<const uint8_t*>(state_ + off().direction));
+  }
+  bool hadOverflow() const {
+    return *reinterpret_cast<const bool*>(state_ + off().had_overflow);
+  }
+  float dimension(Dimension axis) const {
+    return floats(off().dimensions)[static_cast<size_t>(axis)];
+  }
+  float rawDimension(Dimension axis) const {
+    return floats(off().raw_dimensions)[static_cast<size_t>(axis)];
+  }
+  float position(PhysicalEdge edge) const {
+    return floats(off().position)[static_cast<size_t>(edge)];
+  }
+  float margin(PhysicalEdge edge) const {
+    return floats(off().margin)[static_cast<size_t>(edge)];
+  }
+  float border(PhysicalEdge edge) const {
+    return floats(off().border)[static_cast<size_t>(edge)];
+  }
+  float padding(PhysicalEdge edge) const {
+    return floats(off().padding)[static_cast<size_t>(edge)];
+  }
+
+ private:
+  static const BarreRnLayoutOffsets& off() {
+    return detail::gLayoutOffsets;
+  }
+  const float* floats(uint32_t offset) const {
+    return reinterpret_cast<const float*>(state_ + offset);
+  }
+  const std::byte* state_;
+};
+
+inline const std::byte* layoutState(const Node* node) {
+  if (!enabled()) {
+    return nullptr;
+  }
+  const std::byte* state = BarreHostAccess::state(*node);
+  auto header = reinterpret_cast<const BarreRnStateHeader*>(state);
+  if (header->initialized == 0 ||
+      (header->pending & BARRE_RN_PENDING_LAYOUT_RESET) != 0) {
+    return nullptr;
+  }
+  return state;
+}
+
+/* yoga::calculateLayout with barre. Only valid when enabled(). */
+void calculateLayout(
+    Node* node,
+    float ownerWidth,
+    float ownerHeight,
+    Direction ownerDirection);
+
+} // namespace barre
+} // namespace facebook::yoga
