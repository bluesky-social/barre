+  void (*mark_dirty)(void* node);
+  void (*clone_children_if_needed)(void* node);
+  void (*clone_contents_children_if_needed)(void* node);
+  BarreRnSize (*measure)(void* node, float width, uint8_t width_mode, float height, uint8_t height_mode);
+  BarreRnSize (*measure_min_content)(void* node, float width, uint8_t width_mode, float height, uint8_t height_mode);
+  float (*baseline)(void* node, float width, float height);
+} BarreRnHost;
+
+/* Byte offsets, within a node's state, of barre's layout results, so the C
+ * API's YGNodeLayoutGet* read them without calling into Rust. Arrays of
+ * float: position/margin/border/padding indexed by physical edge (left, top,
+ * right, bottom), dimensions/raw_dimensions by YGDimension. `direction` is a
+ * uint8_t YGDirection, `had_overflow` a bool. */
+typedef struct BarreRnLayoutOffsets {
+  uint32_t direction;
+  uint32_t had_overflow;
+  uint32_t dimensions;
+  uint32_t raw_dimensions;
+  uint32_t position;
+  uint32_t margin;
+  uint32_t border;
+  uint32_t padding;
+} BarreRnLayoutOffsets;
+
+/* barre-rn's exports. */
+
+/* Validates and stores the host. Returns false (and barre must not be used)
+ * if the host's ABI, layout or state capacity does not match this build. */
+bool barre_rn_init(const BarreRnHost* host);
+/* Size of barre's per-node state (<= BARRE_RN_STATE_SIZE). */
+size_t barre_rn_state_size(void);
+BarreRnLayoutOffsets barre_rn_layout_offsets(void);
+/* yoga::calculateLayout, by barre. */
+void barre_rn_calculate_layout(
+    void* node,
+    float owner_width,
+    float owner_height,
+    uint8_t owner_direction);
+
+#ifdef __cplusplus
+}
+#endif
