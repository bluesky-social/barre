+#define BARRE_RN_PENDING_LAYOUT_RESET 1u /* Node::setLayout */
+#define BARRE_RN_PENDING_FLEX_BASIS_RESET 2u /* Node::markDirtyAndPropagate */
+#define BARRE_RN_PENDING_STYLE 4u /* any mutable access to the style */
+#define BARRE_RN_PENDING_CONFIG 8u /* Node::setConfig */
+
+/* The first bytes of a node's barre state. An all-zero state (a new or reset
+ * node) is uninitialised; barre initialises it on first use. */
+typedef struct BarreRnStateHeader {
+  uint32_t initialized;
+  uint32_t pending;
+  /* The last layout pass that checked this state: within a pass, a node is
+   * checked once (styles and configs do not change during layout). */
+  uint32_t pass;
+  /* Config::version_ and the config the config snapshot was taken from
