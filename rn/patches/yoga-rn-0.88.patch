+#define BARRE_RN_ABI_VERSION 2
+/* Bytes reserved in every yoga::Node (>= barre_rn_state_size()). */
+#define BARRE_RN_STATE_SIZE 1280
+#define BARRE_RN_STATE_ALIGN 16
+
+/* BarreRnStateHeader::pending bits, set by C++ when something barre keeps a
+ * copy of changes, or when Yoga would reset state barre keeps its own copy
