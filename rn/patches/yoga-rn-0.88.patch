+  uint32_t node_state; /* barreState_ (BARRE_RN_STATE_ALIGN-aligned) */
+  uint32_t node_children; /* std::vector<Node*>: {begin, end, capacity} */
+  uint32_t node_owner; /* Node* */
+  uint32_t node_config; /* const Config* */
+  uint32_t node_contents_children_count; /* size_t */
+  uint32_t node_measure_func; /* function pointers, null when unset */
+  uint32_t node_min_content_measure_func;
+  uint32_t node_baseline_func;
+  uint32_t node_min_content_width; /* FloatOptional (float, NaN = unset) */
+  uint32_t node_min_content_height;
+  BarreRnFlag flag_dirty;
+  BarreRnFlag flag_has_new_layout;
+  BarreRnFlag flag_reference_baseline;
+  BarreRnFlag flag_always_forms_containing_block;
+  BarreRnFlag flag_node_type_text;
+  /* yoga::Config layout */
+  uint32_t config_version; /* uint32_t version_ */
+
+  /* Calls. `node` is a yoga::Node*, `config` a yoga::Config*. */
+  void (*flatten_style)(const void* node, BarreRnStyle* out);
+  void (*read_config)(const void* config, BarreRnConfig* out);
+  /* Node::setDirty(true): runs the dirtied callback. (barre clears the flag
